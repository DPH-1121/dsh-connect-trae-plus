{
  "name": "dsh-connect-trae",
  "displayName": "DSH Connect Trae",
  "description": "Connect locally signed-in Trae models to DeepSeek Harness, plus a read-only usage/credits summary. (Hardened fork: a Trae shim that is missing or not yet listening can no longer abort harness startup.)",
  "version": "2.0.4-dsh.1",
  "author": "dingminhua",
  "copyright": "Copyright (c) 2026 LaoDing",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "trae",
    "model-provider",
    "usage",
    "credits"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tests",
    "docs",
    "scripts",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "DEVELOPMENT.md",
    "FORK.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "tsconfig.json",
    "tsconfig.client.json",
    "tsdown.config.ts",
    "vitest.config.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaydenSmith1121/dsh-connect-trae-plus.git"
  },
  "homepage": "https://github.com/HaydenSmith1121/dsh-connect-trae-plus#readme",
  "bugs": {
    "url": "https://github.com/HaydenSmith1121/dsh-connect-trae-plus/issues"
  },
  "dshCollection": {
    "fork": true,
    "upstream": "https://github.com/dingminhua/dsh-connect-trae",
    "upstreamVersion": "2.0.4",
    "upstreamSha": "9c7c1139b707e11933ae107a8e0213b4ab229614",
    "maintainer": "HaydenSmith1121",
    "source": "https://github.com/HaydenSmith1121/dsh-connect-trae-plus",
    "collection": "https://github.com/HaydenSmith1121/dsh-plugin-collection",
    "changes": "src/shim.ts, src/adapter.ts, src/index.ts — readiness gate, idiomatic disposal, per-region registration",
    "notes": "FORK.md"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-0 <0.2.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.1.5-0 <0.2.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-0 <0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-0 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-0 <0.2.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.5-0 <0.2.0-0",
    "@deepseek-ai/dsh-settings": ">=0.1.5-0 <0.2.0-0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.5-0 <0.2.0-0",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1",
    "@earendil-works/pi-ai": ">=0.85.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-atomic-write": "0.1.5-rc.2",
    "@deepseek-ai/dsh-attachment": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@earendil-works/pi-ai": "^0.85.1",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  }
}